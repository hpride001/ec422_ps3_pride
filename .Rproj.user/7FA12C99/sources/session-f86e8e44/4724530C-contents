library(tidyverse)
library(fpp3)
retail_raw <- read_csv("data/retail_sales_raw.csv")
head(retail_raw)   # 2.2a: note the class of observation_date

retail_raw <- read_csv(
  "data/retail_sales_raw.csv",
  na = ".",
  col_types = cols(
    observation_date = col_date(format = "%Y-%m-%d"),
    RSAFS = col_double(),
    RSAFSNA = col_double()
  )
)

# 2.2a: read_csv() read observation_date as <date> which means it guessed right.
# since the dates are in ISO format which is YYYY-MM-DD. Also in 2.2b
# we had to re read the file that had col_date() so we cant rely on R's guess.

# ---- 2.3 Long format ----
retail_raw_long <- retail_raw |>
  select(observation_date, RSAFS, RSAFSNA) |>
  pivot_longer(cols = c(RSAFS, RSAFSNA), names_to = "series_id", values_to = "sales")
head(retail_raw_long)

# ---- 2.4 tsibble ----
library(fpp3)
retail_ts <- retail_raw_long |>
  mutate(Month = yearmonth(observation_date)) |>
  as_tsibble(index = Month, key = series_id)
head(retail_ts)
has_gaps(retail_ts)

# ---- 2.5 Canadian gas ----
key_vars(canadian_gas)
index_var(canadian_gas)

can_gas <- canadian_gas |>        # the blanks: canadian_gas ...
  select(Month, Volume)
has_gaps(can_gas)                 # ... and can_gas
head(can_gas)

# ---- 2.6 Dates ----
can_gas_recent <- can_gas |>
  filter(Month >= yearmonth("1990 Jan"))
head(can_gas_recent)

can_gas_recent <- can_gas_recent |>
  mutate(year = year(Month),
         month = month(Month, label = TRUE),
         quarter = quarter(Month))

can_gas_recent |>
  as_tibble() |>
  group_by(month) |>
  summarize(avg_volume = mean(Volume))

can_gas_recent |>
  mutate(next_month = Month + 1,
         same_month_last_year = Month - 12) |>
  head()

can_gas_q <- can_gas |>
  filter(Month <= yearmonth("2004 Dec")) |>
  index_by(Quarter = yearquarter(Month)) |>
  summarize(Volume = sum(Volume))
head(can_gas_q)
can_gas_q |> autoplot(Volume)

# 2.6b From 1990 the highest average production was in December (17.1 billion cubic meters)
# January was also close behind with 17.0 and June had the lowest at 14.9. 
# Production was the highest in the winter months and lowest in the summer. 
# February also looks low with 15.3 but it could be because its only 28 days. 

# 2.6d. Because gas production is a flow then each months volume will add to the total. 
# The quarterly production is the sum of three months and the mean would only give average 
# production within the quarter and not the total. The quarterly series is still seasonal
# because Q1 and Q4 are constantly higher then Q2 and Q3.

# ---- 2.7 Plots ----
retail_ts |> autoplot(sales)

retail_ts |>
  autoplot(sales) +
  labs(title = "U.S. Retail and Food Services Sales",
       subtitle = "Seasonally adjusted vs. not seasonally adjusted",
       x = NULL, y = "Millions of dollars", color = NULL) +
  theme_minimal()

# 2.7c
can_gas |>
  autoplot(Volume) +
  labs(title = "Canadian Natural Gas Production",
       x = NULL, y = "Billions of cubic meters") +
  theme_minimal()

# 2.7d (one option: a smoothed trend line)
can_gas |>
  autoplot(Volume) +
  geom_smooth(method = "loess", se = FALSE, color = "red") +
  labs(title = "Canadian Gas Production with Smoothed Trend",
       x = NULL, y = "Billions of cubic meters") +
  theme_minimal()

# 2.7b There is a sharp spike every December in the NSA series probably from 
# holiday shopping which has a drop right after in January and February which 
# repeats every year. The SA series does not have that pattern and is just a smooth
# line in the middle of the NSA series. Both series do have the same upward trend and the 
# same dip from the recession in 2008 / 2009 which is also shown in 2020. The
# seasonal adjust only removes predictable things in the pattern. 

# 2.7d. I chose to add geom_smooth() to make a smooth trend line running 
# through the gas series which makes the pattern in the long run easier to see
# apart from seasonal swings. 